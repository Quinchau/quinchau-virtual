{
  "index": "/index.csr.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/index.csr.html",
          "/*.css",
          "/*.js",
          "/chunk-*.js",
          "/**/*.js",
          "/**/*.css"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
  {
    "name": "product-images",
    "urls": ["/weberp/img/**", "/uploads/**"],
    "cacheConfig": {
      "strategy": "freshness",
      "maxSize": 150,
      "maxAge": "3d",
      "timeout": "5s"
    }
  },
  {
    "name": "api-home",
    "urls": [
      "/api/home/data",
      "/api/config",
      "/api/config/catalogs",
      "/api/config/warehouses",
      "/api/config/branch-catalogs"
    ],
    "cacheConfig": {
      "strategy": "freshness",
      "maxSize": 10,
      "maxAge": "2h",
      "timeout": "3s"
    }
  },
  {
    "name": "api-products",
    "urls": [
      "/api/products",
      "/api/products?*",
      "/api/products/detail",
      "/api/products/detail?*",
      "/api/products/categories",
      "/api/products/units",
      "/api/products/tax-categories"
    ],
    "cacheConfig": {
      "strategy": "freshness",
      "maxSize": 80,
      "maxAge": "30m",
      "timeout": "3s"
    }
  },
  {
    "name": "api-catalog-content",
    "urls": [
      "/api/faqs/**",
      "/api/terminos",
      "/api/terminos/**"
    ],
    "cacheConfig": {
      "strategy": "freshness",
      "maxSize": 30,
      "maxAge": "1h",
      "timeout": "3s"
    }
  },
  {
    "name": "api-orders-read",
    "urls": [
      "/api/orders-sales",
      "/api/orders-sales/history",
      "/api/orders-sales/pending-for-dispatch",
      "/api/orders-sales/pending-for-dispatch?*",
      "/api/orders-sales/pending-for-invoice"
    ],
    "cacheConfig": {
      "strategy": "freshness",
      "maxSize": 20,
      "maxAge": "30m",
      "timeout": "3s"
    }
  },
  {
    "name": "api-orders-detail",
    "urls": [
      "/api/orders-sales/*"
    ],
    "cacheConfig": {
      "strategy": "freshness",
      "maxSize": 100,
      "maxAge": "30m",
      "timeout": "3s"
    }
  },
  {
    "name": "api-transfers",
    "urls": [
      "/api/transfers",
      "/api/transfers/shippers"
    ],
    "cacheConfig": {
      "strategy": "freshness",
      "maxSize": 50,
      "maxAge": "4h",
      "timeout": "3s"
    }
  }
]
}